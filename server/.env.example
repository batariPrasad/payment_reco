# Postgres connection string. Create a dedicated DB/user first, e.g.:
#   CREATE DATABASE payment_reco;
#   CREATE USER payment_reco_app WITH PASSWORD 'change_me';
#   GRANT ALL PRIVILEGES ON DATABASE payment_reco TO payment_reco_app;
DATABASE_URL=postgresql://payment_reco_app:change_me@localhost:5432/payment_reco
# Kwikship API credentials (Dashboard > Admin > Account > API Keys)
KWIKSHIP_BASE_URL=https://api.gokwik.co/kwikship
KWIKSHIP_APP_ID=
KWIKSHIP_APP_SECRET=

PORT=4000

# Production only: set NODE_ENV=production (secure cross-site cookies) and DATABASE_SSL=true when
# connecting to a hosted Postgres from outside its network (Render's External URL). Leave unset locally.
# NODE_ENV=production
# DATABASE_SSL=true

# Auth: OTP-based login + JWT sessions. No self-registration — the first admin is seeded
# from ADMIN_EMAIL the next time `npm run migrate` runs (only if the users table is empty).
JWT_SECRET=
SESSION_HOURS=24
# false = password alone logs in (default); true = also require the emailed OTP (needs SMTP below)
REQUIRE_OTP=false
# Browser origin allowed to call the API (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP for sending OTP emails. Zoho example (swap smtp.zoho.com for smtp.zoho.in / smtp.zoho.eu
# if your account is on a different data center). Use an app-specific password if 2FA is on.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
